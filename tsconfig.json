{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "types": []
  },
  "include": [
    "src",
    "demo",
    "tests"
  ],
  "exclude": [
    "demo/vite.config.ts",
    "vitest.config.ts",
    "demo/dist"
  ]
}
